# Copy to backend/.env and fill in. Never commit .env or show it on screen.
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_MODEL=openai/gpt-oss-120b

# The SEC asks automated clients to identify themselves with real contact details.
SEC_USER_AGENT=Your Name your.email@example.com

# Set to 1 to skip Gemini and use Groq, for testing or demonstrating the fallback.
FORCE_LLM_FAILOVER=0
